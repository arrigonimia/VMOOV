<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.YourAppName" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
    </style>


    <style name="cuerpo">
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/blue</item>
        <item name="android:fontFamily">@font/verd</item>
        I
    </style>

    <style name="cuerpobold">
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/blue</item>
        <item name="android:fontFamily">@font/verd</item>
    </style>

    <style name="forgot">
        <item name="android:textSize">10dp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textColor">@color/colorOff</item>
        <item name="android:fontFamily">@font/verdanaitalic</item>
    </style>


    <style name="titulo">
        <item name="android:textSize">20dp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/verdanabold</item>
    </style>

    <style name="percentage">
        <item name="android:textSize">20dp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/verd</item>
    </style>

    <style name="boton">
        <item name="android:textSize">12dp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/verd</item>
    </style>

    <style name="input" parent="cuerpobold">
        <item name="android:backgroundTint">#26673AB7</item>
        <item name="android:background">?android:attr/editTextBackground</item>
    </style>

    <style name="DayButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:background">@drawable/selector_day_button</item>
        <item name="android:textColor">@color/violet</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:layout_marginVertical">2dp</item>
    </style>

    <style name="TopRoundedCardView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>


</resources>
