<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Zócalo violeta con el logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@color/violet"
            android:gravity="center"
            android:padding="16dp">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="60dp"
                android:src="@drawable/logovmoov"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <!-- Nombre del paciente -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:padding="16dp">

            <TextView
                android:id="@+id/patientNameTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre del Paciente"
                android:textSize="18sp"
                style="@style/titulo"
                android:gravity="center"
                android:padding="12dp"
                android:textColor="@color/violet" />
        </androidx.cardview.widget.CardView>

        <!-- Grid para los parámetros -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="16dp"
            android:weightSum="3">

            <!-- Cantidad de sesiones -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_weight="1"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sesiones"
                        android:textStyle="bold"
                        android:padding="9dp"
                        android:gravity="center"
                        style="@style/cuerpobold"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp" />

                    <EditText
                        android:id="@+id/editTextSessions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Cantidad"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        style="@style/cuerpo"
                        android:padding="16dp"
                        android:inputType="number" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Duración -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_weight="1"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Duración"
                        style="@style/cuerpobold"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:padding="9dp"
                        android:gravity="center"
                        android:layout_marginBottom="12dp" />

                    <EditText
                        android:id="@+id/editTextDuration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Minutos"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:padding="16dp"
                        style="@style/cuerpo"

                        android:inputType="number" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Pasos -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_weight="1"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pasos"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        style="@style/cuerpobold"
                        android:padding="9dp"
                        android:gravity="center"
                        android:layout_marginBottom="12dp" />

                    <EditText
                        android:id="@+id/editTextSteps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Cantidad"
                        style="@style/cuerpo"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:padding="16dp"
                        android:inputType="number" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Observaciones -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="24dp"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Observaciones"
                style="@style/cuerpobold"
                android:padding="9dp"
                android:textSize="16sp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/editTextObservations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Notas adicionales"
                style="@style/cuerpo"
                android:padding="16dp"
                android:inputType="textMultiLine"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:minLines="4"
                android:gravity="bottom" />
        </androidx.cardview.widget.CardView>

        <!-- Botones -->
        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar"
            android:layout_marginTop="68dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver" />

    </LinearLayout>
</ScrollView>
