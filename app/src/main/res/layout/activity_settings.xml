<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/fondo_prueba">

    <!-- 🔹 Zócalo fijo con logo -->
    <LinearLayout
        android:id="@+id/zocalo"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center"
        android:padding="16dp"
        android:background="@color/white"
        android:elevation="8dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:src="@drawable/logovmoov_v"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- 🔹 Contenedor con CardView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/zocalo"
        android:padding="24dp"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <!-- CardView que contiene todo el contenido -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                app:cardCornerRadius="14dp"
                android:backgroundTint="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:gravity="center">

                    <!-- Título -->
                    <TextView
                        android:id="@+id/titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/titulo"
                        android:text="Configuración"
                        android:textColor="@color/violet"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingVertical="12dp"
                        android:layout_marginBottom="20dp"/>

                    <!-- Fila 1: Aumentar y Disminuir Fuente -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingVertical="20dp">

                        <!-- Aumentar fuente -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageButton
                                android:id="@+id/increase_font_button"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/fontsize"
                                android:background="?attr/selectableItemBackground"
                                android:scaleType="centerInside"/>

                            <TextView
                                android:id="@+id/increase_font_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Aumentar Fuente"
                                android:textColor="@color/blue"
                                android:textSize="14sp"
                                android:gravity="center"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>

                        <!-- Disminuir fuente -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageButton
                                android:id="@+id/decrease_font_button"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/fontsize"
                                android:background="?attr/selectableItemBackground"
                                android:scaleType="centerInside"/>

                            <TextView
                                android:id="@+id/decrease_font_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Disminuir Fuente"
                                android:textColor="@color/blue"
                                android:textSize="14sp"
                                android:gravity="center"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Fila 2: Editar Información -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingVertical="20dp">

                        <!-- Editar información -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageButton
                                android:id="@+id/edit_info_button"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/editinfo"
                                android:background="?attr/selectableItemBackground"
                                android:scaleType="centerInside"/>

                            <TextView
                                android:id="@+id/edit_info_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Editar Información"
                                android:textColor="@color/blue"
                                android:textSize="14sp"
                                android:gravity="center"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Botón de Volver -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/back_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/violet"
                        android:layout_marginTop="20dp"
                        android:padding="12dp"
                        app:cardCornerRadius="12dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Volver"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:gravity="center"
                            android:padding="12dp"/>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
