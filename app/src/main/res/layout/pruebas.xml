<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo"
    tools:context=".MenuActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Zócalo violeta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/violet"
            android:gravity="center">

            <!-- Logo VMOOV -->
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Logo VMOOV"
                android:src="@drawable/logovmoov"
                android:scaleType="fitCenter"
                android:paddingBottom="12dp"
                android:paddingTop="12dp" />
        </LinearLayout>

        <!-- Contenedor de columnas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- Primera columna -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Card Última sesión -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_last_session"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="22dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:src="@drawable/ultimases"
                            android:contentDescription="Última sesión" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Última sesión"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/violet" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card Iniciar partida -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_start_game"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:layout_marginBottom="22dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:src="@drawable/connect"
                            android:contentDescription="Iniciar partida" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Iniciar partida"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/violet" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card Cerrar sesión -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_logout"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:src="@drawable/logout"
                            android:contentDescription="Cerrar sesión" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Cerrar sesión"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/violet" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Segunda columna -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="20dp">

                <!-- Card Resumen -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_summary"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:layout_marginBottom="22dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:src="@drawable/historial"
                            android:contentDescription="Resumen" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Historial"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/violet" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card Configuración -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_settings"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="22dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:src="@drawable/settings"
                            android:contentDescription="Configuración" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Configuración"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/violet" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card Contactar profesional -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_contact_hp"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="22dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:src="@drawable/doc"
                            android:contentDescription="Contactar a mi profesional" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Contactar a mi profesional"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textColor="@color/violet" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
