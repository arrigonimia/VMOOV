<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/fondo_prueba">

    <!-- 🔹 Zócalo fijo con logo -->
    <LinearLayout
        android:id="@+id/zocalo"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center"
        android:padding="16dp"
        android:background="@color/white"
        android:elevation="8dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:src="@drawable/logovmoov_v"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- 🔹 Contenedor desplazable -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/zocalo"
        android:padding="16dp"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <!-- CardView del formulario -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="8dp"
                android:backgroundTint="@android:color/white"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <!-- Nombre -->
                    <EditText
                        android:id="@+id/edit_first_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nombre"
                        style="@style/input"
                        android:textSize="14sp"
                        android:inputType="textCapWords"
                        android:layout_marginBottom="10dp"
                        android:maxLength="30"/>

                    <!-- Apellido -->
                    <EditText
                        android:id="@+id/edit_last_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Apellido"
                        style="@style/input"
                        android:layout_marginBottom="10dp"
                        android:textSize="14sp"
                        android:inputType="textCapWords"
                        android:maxLength="30"/>

                    <!-- DNI -->
                    <EditText
                        android:id="@+id/edit_dni"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="DNI"
                        style="@style/input"
                        android:layout_marginBottom="10dp"
                        android:textSize="14sp"
                        android:inputType="number"
                        android:maxLength="8"/>

                    <!-- Teléfono -->
                    <EditText
                        android:id="@+id/edit_phone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Teléfono"
                        style="@style/input"
                        android:textSize="14sp"
                        android:layout_marginBottom="10dp"
                        android:inputType="phone"
                        android:maxLength="10"/>

                    <!-- Género -->
                    <Spinner
                        android:id="@+id/gender_spinner"
                        style="@style/cuerpobold"
                        android:padding="16dp"
                        android:background="@drawable/spinner_background"
                        android:layout_marginBottom="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Email -->
                    <EditText
                        android:id="@+id/edit_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/input"
                        android:layout_marginBottom="10dp"
                        android:textSize="14sp"
                        android:hint="Correo electrónico"
                        android:inputType="textEmailAddress"/>

                    <!-- Fecha de Nacimiento -->
                    <TextView
                        android:id="@+id/edit_birth_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Fecha de Nacimiento"
                        android:layout_marginBottom="10dp"
                        android:padding="16dp"
                        style="@style/cuerpo"
                        android:background="@drawable/spinner_background"
                        android:textColor="@android:color/black"
                        android:textSize="14sp"
                        android:gravity="left"
                        android:clickable="true"
                        android:focusable="true"/>

                    <!-- Obra Social -->
                    <Spinner
                        android:id="@+id/obra_social_spinner"
                        android:layout_width="match_parent"
                        style="@style/cuerpobold"
                        android:padding="16dp"
                        android:textColor="@android:color/black"
                        android:background="@drawable/spinner_background"
                        android:layout_marginBottom="10dp"
                        android:layout_height="wrap_content" />

                    <!-- Número de Afiliado -->
                    <EditText
                        android:id="@+id/edit_numero_afiliado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/input"
                        android:textSize="14sp"
                        android:layout_marginBottom="0dp"
                        android:hint="Número de Afiliado"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 🔹 Botones en una fila: Volver (izquierda) y Guardar (derecha) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="10dp">

                <!-- Botón Volver (Izquierda) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/back_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="8dp"
                    android:backgroundTint="@color/violet"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Volver"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        style="@style/cuerpobold"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:padding="14dp"/>
                </androidx.cardview.widget.CardView>

                <!-- Botón Guardar (Derecha) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/save_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="8dp"
                    android:backgroundTint="@color/blue"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Guardar"
                        style="@style/cuerpobold"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:padding="14dp"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
