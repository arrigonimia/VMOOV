<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_prueba"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Zócalo violeta con el logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:padding="16dp"
            android:background="@color/white">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="60dp"
                android:src="@drawable/logovmoov_v"
                android:scaleType="fitCenter" />
        </LinearLayout>


        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Centros de Atención"
            android:textSize="20sp"
            style="@style/titulo"
            android:gravity="center"
            android:padding="16dp"
            android:textColor="@color/white" />

        <!-- Contenedor donde se agregarán dinámicamente los centros -->
        <LinearLayout
            android:id="@+id/centersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="12dp" />

        <!-- Contenedor para los botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="100dp">

            <!-- Botón para agregar más centros -->
            <androidx.cardview.widget.CardView
                android:id="@+id/addCenterButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/blue"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Agregar Centro"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:padding="12dp"
                    style="@style/cuerpobold" />
            </androidx.cardview.widget.CardView>

            <!-- Botón para guardar -->
            <androidx.cardview.widget.CardView
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/blue"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Guardar"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:padding="12dp"
                    android:textSize="16sp"
                    style="@style/cuerpobold" />
            </androidx.cardview.widget.CardView>

            <!-- Botón para volver -->
            <androidx.cardview.widget.CardView
                android:id="@+id/backButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/blue"
                android:padding="14dp">

                <TextView
                    android:id="@+id/backButtonText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Volver"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:padding="12dp"
                    style="@style/cuerpobold" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
